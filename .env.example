# Google OAuth Client ID (Frontend)
VITE_GOOGLE_CLIENT_ID=YOUR_GOOGLE_OAUTH_CLIENT_ID.apps.googleusercontent.com

# Postgres Configuration (docker-compose)
POSTGRES_USER=emailauto
POSTGRES_PASSWORD=emailauto
POSTGRES_DB=emailauto
POSTGRES_PORT=5432

# Go Server Configuration
SERVER_PORT=8080
DATABASE_URL=postgres://emailauto:emailauto@localhost:5432/emailauto?sslmode=disable
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
LOG_LEVEL=info
ENV=development
MIGRATE_ON_STARTUP=true
UPLOAD_DIR=./uploads

# Gemini LLM Configuration
GEMINI_API_KEY=YOUR_GEMINI_API_KEY
GEMINI_MODEL=gemini-2.5-flash
GEMINI_RPM=30
GEMINI_TIMEOUT_SECONDS=30

# Server-Side Google OAuth 2.0 Configuration
GOOGLE_CLIENT_ID=YOUR_GOOGLE_CLIENT_ID.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=YOUR_GOOGLE_CLIENT_SECRET
GOOGLE_REDIRECT_URL=http://localhost:8080/auth/callback
ENCRYPTION_KEY=replace-with-a-secure-32-byte-or-more-key-for-aes-gcm
FRONTEND_URL=http://localhost:5173
